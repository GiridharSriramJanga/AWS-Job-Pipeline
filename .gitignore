# ── Data files — never commit real scraped data ───────────────────────────────
*.parquet
*.csv
*.xlsx
*.json

# ── Logs — stay local on EC2 only ────────────────────────────────────────────
logs/
*.log

# ── Environment and credentials — CRITICAL: never commit these ───────────────
.env
*.env
.env.*

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# ── Testing and coverage ──────────────────────────────────────────────────────
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/

# ── Jupyter notebooks (if any exploratory work) ───────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── EC2 and local download directories ───────────────────────────────────────
/home/ec2-user/data_downloads/
data_downloads/

# ── OS generated files ────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Model cache (sentence transformers downloads) ─────────────────────────────
.cache/
sentence_transformers/
transformers_cache/
